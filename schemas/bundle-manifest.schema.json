{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:caf:schema:bundle-manifest/v2",
  "title": "CAF bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "vendor_id",
    "key_mode",
    "kms_key",
    "wrapped_dek",
    "nonce",
    "ciphertext_sha256",
    "plaintext_sha256",
    "vendor_hpke_public_key"
  ],
  "properties": {
    "format": {
      "const": "caf-bundle/v2"
    },
    "vendor_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,32}$"
    },
    "key_mode": {
      "enum": [
        "operator",
        "vendor"
      ]
    },
    "kms_key": {
      "type": "string",
      "pattern": "^projects/.+/locations/.+/keyRings/.+/cryptoKeys/.+$"
    },
    "wrapped_dek": {
      "type": "string",
      "contentEncoding": "base64"
    },
    "nonce": {
      "type": "string",
      "contentEncoding": "base64"
    },
    "ciphertext_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plaintext_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "vendor_hpke_public_key": {
      "type": "string",
      "contentEncoding": "base64"
    }
  },
  "description": "Untrusted until the payload decrypts: vendor_id, key_mode, kms_key and vendor_hpke_public_key are bound into the payload's AES-GCM associated data, which the workload recomputes rather than reading from here."
}
